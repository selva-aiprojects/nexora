PORT=4000
# Persistence backend for the `db` seam. Options: sqlite (default, on-disk
# file — zero dependencies, runs anywhere) or memory (ephemeral, for tests).
DB_IMPL=sqlite
# Path is resolved relative to the server working directory.
SQLITE_PATH=./data/nexora.db

# ---- Production target (PostgreSQL + RLS) ----
# Spin up with: docker compose -f infra/docker-compose.yml up -d
# DATABASE_URL=postgres://nexora:nexora_dev@localhost:5432/nexora
