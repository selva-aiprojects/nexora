{
  "name": "nexora-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexora AI-Native Business Operating Platform — backend services (modular monolith)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@vercel/postgres": "^0.10.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "neon-serverless": "^0.5.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
